{
  "name": "ssh-console",
  "version": "1.3.0",
  "description": "Control any server over SSH: Docker containers, systemd services, processes, ports, files, databases and terminals. Runs as a web app, a macOS app or a Debian/Ubuntu app.",
  "main": "desktop/main.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "dist:mac": "electron-builder --mac dmg zip --arm64",
    "dist:mac-universal": "electron-builder --mac dmg zip --universal",
    "dist:deb": "electron-builder --linux deb --x64",
    "dist:deb-arm64": "electron-builder --linux deb --arm64",
    "dist:deb-all": "electron-builder --linux deb --x64 --arm64",
    "dist:appimage": "electron-builder --linux AppImage --x64",
    "dist:appimage-arm64": "electron-builder --linux AppImage --arm64",
    "dist:release": "npm run dist:mac && electron-builder --linux deb AppImage --x64 && npm run release",
    "release": "node scripts/release.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^5.3.0",
    "material-icon-theme": "^5.40.0",
    "monaco-editor": "^0.57.0",
    "ssh2": "^1.17.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "productName": "ssh-console",
  "desktopName": "ssh-console.desktop",
  "author": "Amit Das",
  "homepage": "https://distronix.in",
  "updateRepo": "YOUR-GITHUB-USER/ssh-console-releases",
  "build": {
    "appId": "in.distronix.ssh-console",
    "productName": "ssh-console",
    "copyright": "Copyright © 2026 Amit Das",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "server.js",
      "lib/**",
      "public/**",
      "desktop/**",
      "package.json",
      "!**/*.map",
      "!node_modules/monaco-editor/{esm,dev,vs,min-maps}/**",
      "!node_modules/monaco-editor/monaco.d.ts",
      "!node_modules/material-icon-theme/dist/{module,types}/**"
    ],
    "npmRebuild": false,
    "asar": true,
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true
    },
    "dmg": {
      "title": "ssh-console",
      "contents": [
        {
          "x": 140,
          "y": 190
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "executableName": "ssh-console",
      "maintainer": "Amit Das <amit@distronix.in>",
      "vendor": "Distronix",
      "synopsis": "Control servers over SSH: Docker, services, files, databases and terminals",
      "syncDesktopName": true
    },
    "deb": {
      "artifactName": "${name}_${version}_${arch}.${ext}",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ],
      "priority": "optional"
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false,
      "resetAdHocDarwinSignature": true
    }
  }
}
